@@ -0,0 +1,57 @@
+:root {
+  color-scheme: dark;
+  --bg: #11191d;
+  --panel: #1b272e;
+  --line: #3b4e57;
+  --fg: #f3f6f6;
+  --muted: #b7c6ce;
+  --accent: #c9e3ed;
+  font: 16px/1.45 Arial, sans-serif;
+}
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+body { margin: 0; background: var(--bg); color: var(--fg); }
+.site-header, main { max-width: 1800px; margin: auto; padding-inline: clamp(14px, 3vw, 48px); }
+.site-header { display: flex; justify-content: space-between; align-items: end; gap: 12px; padding-top: 18px; padding-bottom: 14px; }
+.brand { margin: 0 0 4px; color: var(--accent); font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; }
+h1 { margin: 0; font-size: clamp(32px, 4vw, 54px); line-height: 1; letter-spacing: -.045em; }
+h2 { margin: 0; font-size: 1.17rem; }
+.site-header .build-info { margin: 0; color: var(--muted); font-size: .72rem; }
+nav { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 9px; }
+button, select { font: inherit; color: inherit; border: 1px solid var(--line); background: var(--panel); padding: .48rem .65rem; border-radius: 4px; cursor: pointer; }
+button:hover, button:focus-visible, select:focus-visible, a:focus-visible { border-color: var(--accent); outline-color: var(--accent); }
+button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #192c35; font-weight: bold; }
+a { color: var(--accent); text-underline-offset: .2em; }
+.layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(230px, 270px); gap: 12px; padding-bottom: 14px; align-items: start; }
+.stage { position: sticky; top: 8px; height: clamp(440px, 76vh, 1040px); overflow: hidden; isolation: isolate; background: #aebcc7; border: 1px solid var(--line); border-radius: 5px; }
+.stage:fullscreen { height: 100%; border: 0; border-radius: 0; }
+#scene, iframe { width: 100%; height: 100%; }
+iframe { display: block; border: 0; }
+#load-state { position: absolute; left: 14px; bottom: 14px; max-width: calc(100% - 28px); padding: 7px 12px; margin: 0; border-radius: 4px; background: #16252e; color: white; pointer-events: none; }
+aside { background: #172229; border: 1px solid var(--line); border-radius: 5px; padding: 14px; }
+.notes { color: var(--muted); font-size: .85rem; margin: .55rem 0 .8rem; }
+.base-wall, select { width: 100%; text-align: left; }
+.family { margin: .65rem 0; padding-bottom: .55rem; border-bottom: 1px solid var(--line); font-size: .92rem; }
+.choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; margin-top: .35rem; }
+.cameras { margin-top: 10px; }
+.cameras button { font-size: .76rem; padding-inline: 4px; }
+.field { display: block; margin: .8rem 0 .35rem; font-size: .82rem; color: var(--muted); }
+.checkpoints { display: grid; gap: 3px; }
+.checkpoints button { text-align: left; font-size: .86rem; padding: .37rem .5rem; }
+.scene-links { border-top: 1px solid var(--line); margin-top: .85rem; padding-top: .75rem; display: flex; gap: .55rem; flex-direction: column; align-items: start; font-size: .82rem; }
+#reference-panel > p { display: flex; flex-wrap: wrap; gap: 8px 24px; }
+.gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 12px; padding-bottom: 20px; }
+.gallery button { display: flex; flex-direction: column; text-align: left; padding: 0; overflow: hidden; }
+.gallery img { display: block; width: 100%; height: auto; aspect-ratio: 1.9; object-fit: cover; object-position: center; }
+.gallery span { padding: .6rem; }
+dialog { max-width: 96vw; max-height: 96vh; background: var(--bg); border: 1px solid var(--line); padding: 8px; }
+dialog::backdrop { background: #050a0edb; }
+dialog form { display: flex; justify-content: end; padding-bottom: 8px; }
+dialog img { display: block; max-width: 90vw; max-height: 83vh; object-fit: contain; }
+@media (max-width: 740px) {
+  .layout { display: flex; flex-direction: column; }
+  .stage { position: relative; top: 0; width: 100%; height: max(340px, 57vh); }
+  aside { width: 100%; }
+  .site-header .build-info { max-width: 42vw !important; }
+  nav button { flex: 1 1 auto; font-size: .84rem; }
+}
