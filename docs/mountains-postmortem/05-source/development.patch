+++ b/experiments/plateau/slice-wall-angular.ts
@@ -0,0 +1,303 @@
+import { Color, Ray, Triangle, Vector3 } from 'three';
+import { Rng } from '../../src/core/rng';
+
+type Site = {
+  x: number;
+  z: number;
+  angle: number;
+  width: number;
+  height: number;
+  groundAt: (x: number, z: number) => number;
+};
+
+type Mass = {
+  firstTriangle: number;
+  triangles: number;
+  minU: number;
+  maxU: number;
+  minV: number;
+  maxV: number;
+};
+
+type Buffer = { positions: number[]; indices: number[]; colors: number[] };
+
+function buffer(): Buffer {
+  return { positions: [], indices: [], colors: [] };
+}
+
+function addPoint(mesh: Buffer, point: Vector3, color: Color) {
+  const index = mesh.positions.length / 3;
+  mesh.positions.push(point.x, point.y, point.z);
+  mesh.colors.push(color.r, color.g, color.b);
+  return index;
+}
+
+function pack(mesh: Buffer) {
+  return {
+    positions: Float32Array.from(mesh.positions),
+    indices: Uint32Array.from(mesh.indices),
+    colors: mesh.colors,
+  };
+}
+
+const palette = ['#565e6e', '#677182', '#666a78', '#747782', '#5c626e'];
+const white = new Color(1, 1, 1);
+
+type Face = { vertices: Vector3[]; retention?: number[] };
+
+// Sample the pile once from the fixed entrance-side direction. Hidden backs
+// and buried courses must not increase the amount of snow on the front.
+// This runs when a preset is built and has no dependency on the current camera.
+function snowLine(faces: Face[], site: Site, tx: number, tz: number) {
+  const u = -site.width * 0.91, v = site.width * 3.38;
+  const eye = new Vector3(site.x + tx * u + tz * v, 1.50 * site.height, site.z + tz * u - tx * v);
+  const outward = new Vector3(tz - 0.19 * tx, 0.07, -tx - 0.19 * tz).normalize();
+  const right = new Vector3(outward.z, 0, -outward.x).normalize();
+  const up = outward.clone().cross(right);
+  const points = faces.flatMap(face => face.vertices).map(p => p.clone().sub(eye));
+  const x = points.map(p => p.dot(right) / -p.dot(outward));
+  const y = points.map(p => p.dot(up) / -p.dot(outward));
+  const left = Math.min(...x), bottom = Math.min(...y);
+  const width = Math.max(...x) - left, height = Math.max(...y) - bottom;
+  const ray = new Ray(eye);
+  const hit = new Vector3(), weights = new Vector3(), retention: number[] = [];
+  const columns = 40, rows = 32;
+  for (let i = 0; i < rows; i++) {
+    for (let j = 0; j < columns; j++) {
+      ray.direction.copy(outward).negate()
+        .addScaledVector(right, left + width * (j + 0.5) / columns)
+        .addScaledVector(up, bottom + height * (i + 0.5) / rows).normalize();
+      let closest = Infinity, deposit = -1;
+      for (const face of faces) {
+        const [a, b, c] = face.vertices;
+        if (!ray.intersectTriangle(a, b, c, true, hit)) continue;
+        const d = ray.origin.distanceToSquared(hit);
+        if (d >= closest) continue;
+        closest = d;
+        deposit = -1;
+        if (face.retention) {
+          Triangle.getBarycoord(hit, a, b, c, weights);
+          const [qa, qb, qc] = face.retention;
+          deposit = weights.x * qa + weights.y * qb + weights.z * qc;
+        }
+      }
+      if (closest < Infinity) retention.push(deposit);
+    }
+  }
+  retention.sort((a, b) => b - a);
+  return retention[Math.floor(retention.length * 0.25)] ?? 0;
+}
+
+function capAboveSnowLine(snow: Buffer, face: Face, threshold: number) {
+  if (!face.retention) return;
+  const patch: Vector3[] = [];
+  for (let i = 0; i < 3; i++) {
+    const j = (i + 1) % 3, a = face.vertices[i], b = face.vertices[j];
+    const qa = face.retention[i], qb = face.retention[j];
+    if (qa >= threshold) patch.push(a.clone());
+    if ((qa > threshold && qb < threshold) || (qa < threshold && qb > threshold)) {
+      patch.push(a.clone().lerp(b, (threshold - qa) / (qb - qa)));
+    }
+  }
+  if (patch.length < 3) return;
+  const first = snow.positions.length / 3;
+  for (const p of patch) {
+    p.y += 0.055;
+    addPoint(snow, p, white);
+  }
+  // All vertices have the same vertical offset from their supporting plane,
+  // including the ends of every shared edge between two snow-bearing planes.
+  for (let i = 1; i < patch.length - 1; i++) snow.indices.push(first, first + i, first + i + 1);
+}
+
+type Ridge = { a: number; b: number; neighbors: number[] };
+
+// On a sharp, completely snow-covered crest, multisample depth testing can
+// expose the stone in a single sample. Give the snow room only inside that
+// buried fold. The original boundary vertices and snow surface stay in place.
+function recessCoveredRidges(rock: Buffer, faces: Face[], ridges: Ridge[], masses: Mass[], line: number) {
+  const replacements = new Map<number, number[]>();
+  const point = (id: number) => new Vector3().fromArray(rock.positions, id * 3);
+  for (const ridge of ridges) {
+    const { a, b, neighbors } = ridge;
+    const panels = neighbors.map(t => {
+      const ids = rock.indices.slice(3 * t, 3 * t + 3);
+      const opposite = ids.find(id => id !== a && id !== b)!;
+      const q = faces[t].retention;
+      const qa = q?.[ids.indexOf(a)], qb = q?.[ids.indexOf(b)];
+      const guarded = q && qa !== undefined && qb !== undefined
+        && Math.min(qa, qb, 0.48 * (qa + qb) + 0.04 * q[ids.indexOf(opposite)]) >= line;
+      const normal = Triangle.getNormal(...(faces[t].vertices as [Vector3, Vector3, Vector3]), new Vector3());
+      return { t, ids, opposite, covered: guarded, normal };
+    });
+    if (!panels.every(face => face.covered) || panels[0].normal.dot(panels[1].normal) >= 0.5) continue;
+    const av = point(a), bv = point(b), middle = av.clone().lerp(bv, 0.5);
+    const tint = new Color().fromArray(rock.colors, a * 3);
+    const low = [0.075, 0.925].map(t => {
+      const p = av.clone().lerp(bv, t);
+      p.y -= 0.32;
+      return addPoint(rock, p, tint);
+    });
+    for (const { t, ids, opposite } of panels) {
+      const side = middle.clone().lerp(point(opposite), 0.04);
+      const guard = addPoint(rock, side, tint);
+      const forward = ids[(ids.indexOf(opposite) + 1) % 3] === a;
+      const [v0, l0, l1, v1] = forward ? [a, ...low, b] : [b, low[1], low[0], a];
+      replacements.set(t, [
+        v0, l0, guard, l0, l1, guard, l1, v1, guard,
+        v0, guard, opposite, guard, v1, opposite,
+      ]);
+    }
+  }
+
+  const original = rock.indices;
+  rock.indices = [];
+  for (const mass of masses) {
+    const start = mass.firstTriangle, end = start + mass.triangles;
+    mass.firstTriangle = rock.indices.length / 3;
+    for (let t = start; t < end; t++) {
+      const revised = replacements.get(t);
+      if (revised) rock.indices.push(...revised);
+      else rock.indices.push(original[3 * t], original[3 * t + 1], original[3 * t + 2]);
+    }
+    mass.triangles = rock.indices.length / 3 - mass.firstTriangle;
+  }
+}
+
+// A talus fan in three dimensions. The rear line carries the tall, tilted
+// blocks; successive courses occupy the pockets below them toward the toe.
+export function buildAngularWall(site: Site, count: number, seed: number) {
+  if (![5, 8, 12].includes(count)) throw new RangeError('Angular wall presets are 5, 8 and 12.');
+  const rng = new Rng(seed ^ 0x58ee46), rock = buffer(), snow = buffer();
+  const rows = count === 5 ? [3, 2] : count === 8 ? [3, 3, 2] : [4, 4, 4];
+  const tx = Math.cos(site.angle), tz = Math.sin(site.angle);
+  function point(u: number, v: number, y: number) {
+    return new Vector3(site.x + tx * u + tz * v, y, site.z + tz * u - tx * v);
+  }
+  const masses: Mass[] = [];
+  const faces: Face[] = [];
+  const ridges: Ridge[] = [];
+  // Each row has shared cell boundaries. Its fracture planes stay inside
+  // those cells, including at the widest seam between adjacent boulders.
+  const maxDepth = site.width * 0.84;
+  const rowDepth = maxDepth / rows.length;
+  for (const [row, columns] of rows.entries()) {
+    const phase = row / (rows.length - 1);
+    const shift = (row % 2 ? -1 : 1) * site.width * 0.028;
+    const rowWidth = site.width * (columns === 2 ? 0.67 : 0.94);
+    const cellWidth = rowWidth / columns;
+    const boundaries = Array.from({ length: columns + 1 }, (_, i) =>
+      shift - rowWidth / 2 + i * cellWidth +
+      (i > 0 && i < columns ? rng.float(-0.04, 0.04) * cellWidth : 0));
+    for (let col = 0; col < columns; col++) {
+      const lo = boundaries[col], hi = boundaries[col + 1];
+      const span = Math.min(hi - lo, site.width / 3) * rng.float(0.95, 0.997);
+      const u = (lo + hi) / 2;
+      const v = rowDepth * (row + 0.5) + site.width * 0.02;
+      const depth = rowDepth * rng.float(0.9, 0.985);
+      const h = site.height * (0.67 - 0.43 * phase) * rng.float(0.67, 1.16);
+      const shoulder = rng.float(0.38, 0.65);
+      const shoulderTip = rng.float(-0.27, 0.27);
+      const outline = [
+        [-0.50, rng.float(-0.36, -0.17)], [rng.float(-0.33, 0.04), -0.50],
+        [0.49, rng.float(-0.38, -0.18)], [rng.float(0.28, 0.49), rng.float(0.12, 0.36)],
+        [rng.float(-0.06, 0.23), 0.50], [-0.48, rng.float(0.13, 0.38)],
+      ];
+      const ground = (du: number, dv: number) => {
+        const p = point(u + du, v + dv, 0);
+        return site.groundAt(p.x, p.z);
+      };
+      const base = Math.min(...outline.map(([x, z]) => ground(x * span, z * depth))) - 1.8;
+      const tint = new Color(rng.pick(palette));
+      const points: Vector3[] = [];
+      const tris: number[] = [];
+      for (const [x, z] of outline) {
+        points.push(point(u + x * span * 0.81, v + z * depth * 0.84, base));
+      }
+      for (const [x, z] of outline) {
+        const height = shoulder + shoulderTip * x - 0.17 * z + rng.float(-0.07, 0.07);
+        points.push(point(u + x * span, v + z * depth, base + h * height));
+      }
+      // A diagonal fracture ridge meets the broken eaves. There is no level
+      // cap: its two ends can differ by a third of the whole boulder's height.
+      const ridgeSlope = rng.pick([-1, 1]) * rng.float(0.11, 0.25);
+      const ridgeDepth = rng.float(-0.16, 0.03);
+      const ridgeTwist = rng.float(-0.12, 0.12);
+      points.push(
+        point(u - span * rng.float(0.26, 0.43), v + (ridgeDepth + ridgeTwist) * depth, base + h * (0.86 + ridgeSlope)),
+        point(u + span * rng.float(0.17, 0.39), v + (ridgeDepth - ridgeTwist) * depth, base + h * (0.86 - ridgeSlope)),
+      );
+      const n = outline.length;
+      for (let i = 1; i < n - 1; i++) tris.push(0, i + 1, i);
+      for (let i = 0; i < n; i++) {
+        const a = i, b = (i + 1) % n;
+        tris.push(a, b, b + n, a, b + n, a + n);
+      }
+      const roof = [
+        0, 1, 6,  1, 2, 7,  1, 7, 6,  2, 3, 7,
+        3, 4, 7,  4, 6, 7,  4, 5, 6,  5, 0, 6,
+      ];
+      for (const index of roof) tris.push(n + index);
+      const start = rock.indices.length / 3;
+      const offset = rock.positions.length / 3;
+      for (const p of points) addPoint(rock, p, tint);
+      for (const index of tris) rock.indices.push(offset + index);
+
+      // Both ends of the ridge retain snow. Wind exposure varies around its
+      // broken edge; the same vertex has the same value on adjoining planes.
+      const wind = rng.float(-Math.PI, Math.PI);
+      const retention = points.map((p, id) => {
+        const pu = (p.x - site.x) * tx + (p.z - site.z) * tz;
+        const pv = (p.x - site.x) * tz - (p.z - site.z) * tx;
+        const exposure = Math.cos(wind) * (pu - u) / span + Math.sin(wind) * (pv - v) / depth;
+        return (id >= 2 * n ? 0.82 : 0.38) + 0.34 * exposure + 0.20 * (p.y - base) / h;
+      });
+      const ridge: Ridge = { a: offset + 2 * n, b: offset + 2 * n + 1, neighbors: [] };
+      for (let i = 0; i < tris.length; i += 3) {
+        const ids = tris.slice(i, i + 3);
+        const vertices = ids.map(id => points[id]);
+        const [a, b, c] = vertices;
+        const normal = b.clone().sub(a).cross(c.clone().sub(a)).normalize();
+        const roofFace = i >= tris.length - roof.length;
+        const canHoldSnow = roofFace && normal.y > 0.46;
+        if (ids.includes(2 * n) && ids.includes(2 * n + 1)) ridge.neighbors.push(faces.length);
+        faces.push({ vertices, retention: canHoldSnow ? ids.map(id => retention[id]) : undefined });
+      }
+      ridges.push(ridge);
+      masses.push({
+        firstTriangle: start, triangles: rock.indices.length / 3 - start,
+        minU: u - span * 0.5, maxU: u + span * 0.5,
+        minV: v - depth * 0.5, maxV: v + depth * 0.5,
+      });
+    }
+  }
+  const threshold = snowLine(faces, site, tx, tz);
+  recessCoveredRidges(rock, faces, ridges, masses, threshold);
+  for (const face of faces) capAboveSnowLine(snow, face, threshold);
+  // A low snow bank fills the crevices at ground level. Radial ends dip
+  // below the actual ground, so the bank has no open visible hem.
+  const snowWallIndexCount = snow.indices.length;
+  const footV = maxDepth * 0.93;
+  const bankOffset = snow.positions.length / 3;
+  const bankProfile = [
+    [-rowDepth * 0.71, -0.35], [-rowDepth * 0.32, 2.4], [0.1, 3.1],
+    [rowDepth * 0.24, 1], [rowDepth * 0.50, -0.35],
+  ];
+  for (let i = 0; i <= 16; i++) {
+    const t = i / 16, u = (t - 0.5) * site.width * 1.02;
+    const taper = Math.sin(t * Math.PI);
+    const crest = footV + Math.sin(t * 13) * rowDepth * 0.13;
+    for (const [distance, height] of bankProfile) {
+      const p = point(u, crest + distance, 0);
+      p.y = site.groundAt(p.x, p.z) - 0.30 + taper * height;
+      addPoint(snow, p, white);
+    }
+  }
+  for (let i = 0; i < 16; i++) {
+    for (let k = 0; k < bankProfile.length - 1; k++) {
+      const a = bankOffset + i * bankProfile.length + k, b = a + bankProfile.length;
+      snow.indices.push(a, b, b + 1, a, b + 1, a + 1);
+    }
+  }
+  return { rock: pack(rock), snow: pack(snow), masses, snowWallIndexCount };
+}
diff --git a/experiments/plateau/slice-wall-rounded.test.cjs b/experiments/plateau/slice-wall-rounded.test.cjs
new file mode 100644
index 0000000..34936a5
--- /dev/null
+++ b/experiments/plateau/slice-wall-rounded.test.cjs
@@ -0,0 +1,107 @@
+const assert = require('node:assert/strict');
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const ts = require('typescript');
+require.extensions['.ts'] = (module, file) => module._compile(
+  ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 }
+  }).outputText, file);
+const { buildRoundedWall } = require('./slice-wall-rounded.ts');
+const { plateauTop, mountainEnding } = require('./mountain-shape.ts');
+const { reliefGrid } = require('./seam-relief-fixture.ts');
+const { buildWedgeAscent } = require('./wedge-ascent.ts');
+const { bluntTip } = require('./wedge-tip-profile.ts');
+const { mountainRim } = require('./mountain-snow.ts');
+const { ringPoint } = require('./wedge-snow-layer.ts');
+const { contourTangent } = require('./plateau-profile.ts');
+const { sampleGrid } = require('./seam-boundary.ts');
+const { ascentSample } = require('./ascent.ts');
+const { surfaceRoof } = require('./wedge-rocks.ts');
+
+const source = reliefGrid(plateauTop);
+const heights = source.heights.map((_, i) => plateauTop(
+  source.x0 + i % (source.n + 1) * source.cell,
+  source.z0 + Math.floor(i / (source.n + 1)) * source.cell));
+const junction = buildWedgeAscent(source, { ...source, heights }, mountainEnding, bluntTip);
+const angle = Math.PI + 0.78;
+const p = ringPoint(mountainRim(junction), angle);
+const tangent = contourTangent(angle);
+const roof = surfaceRoof([junction.cut.plateau, junction.cut.strip]);
+const site = {
+  x: p.x, z: p.z, angle: Math.atan2(tangent.z, tangent.x), width: 100, height: p.y,
+  groundAt: (x, z) => sampleGrid(source, x, z).y
+};
+const seen = new Set();
+const rows = [];
+for (const count of [4, 7, 10]) {
+  for (const seed of [42, 7, 8191, Number(process.env.NEW_SEED || 23011)]) {
+    const wall = buildRoundedWall(site, count, seed);
+    const repeated = buildRoundedWall(site, count, seed);
+    assert.deepEqual(wall, repeated);
+    const sha = crypto.createHash('sha256').update(wall.rock.positions).update(wall.snow.positions).digest('hex');
+    assert.ok(!seen.has(sha));
+    seen.add(sha);
+    assert.equal(wall.masses.length, count);
+    let maxWidth = 0;
+    let minSnowNormal = 1;
+    let minPassClearance = Infinity;
+    let maxRoofIntrusion = 0;
+    const edges = new Map();
+    // Combined rock and snow crowns form a closed oriented shell. Foot drifts
+    // intentionally end below the sampled terrain and are tested separately.
+    for (const [material, mesh] of [['rock', wall.rock], ['snow', wall.snow]]) {
+      const { indices, positions } = mesh;
+      assert.equal(mesh.colors.length, positions.length);
+      for (let k = 0; k < indices.length; k += 3) {
+        const triangle = Array.from(indices.subarray(k, k + 3), (id) =>
+          Array.from(positions.subarray(3 * id, 3 * id + 3)));
+        const [a, b, c] = triangle;
+        const ab = b.map((x, i) => x - a[i]), ac = c.map((x, i) => x - a[i]);
+        const normal = [ab[1]*ac[2]-ab[2]*ac[1], ab[2]*ac[0]-ab[0]*ac[2], ab[0]*ac[1]-ab[1]*ac[0]];
+        const length = Math.hypot(...normal);
+        assert.ok(length > 1e-6);
+        if (material === 'snow' && k < wall.capTriangleCount * 3) {
+          minSnowNormal = Math.min(minSnowNormal, normal[1] / length);
+          assert.ok(normal[1] / length > 0.58, 'Snow on a vertical or downward rock face');
+        }
+        const roofClearance = roof.triangleClearance(triangle.map(([x,y,z]) => ({x,y,z})));
+        maxRoofIntrusion = Math.max(maxRoofIntrusion, -roofClearance);
+        for (const [x,y,z] of [...triangle, a.map((v,i) => (v+b[i]+c[i])/3)]) {
+          assert.ok([x,y,z].every(Number.isFinite));
+          const ramp = ascentSample(x);
+          if (x >= -300 && x <= 20) minPassClearance = Math.min(minPassClearance, Math.abs(z-ramp.z) - ramp.w);
+        }
+        if (material === 'rock' || k < 3 * wall.capTriangleCount) {
+          for (let j = 0; j < 3; j++) {
+            const aKey = triangle[j].join(','), bKey = triangle[(j+1)%3].join(',');
+            const key = aKey < bKey ? aKey+'|'+bKey : bKey+'|'+aKey;
+            const edge = edges.get(key) || [0,0];
+            edge[0]++; edge[1] += aKey < bKey ? 1 : -1; edges.set(key,edge);
+          }
+        }
+      }
+    }
+    for (const [uses, direction] of edges.values()) assert.deepEqual([uses, direction], [2, 0]);
+    assert.ok(minPassClearance > 2, 'Entrance piece intrudes into the existing passage');
+    assert.equal(maxRoofIntrusion, 0, 'A triangle emerges through the plateau');
+    for (const [i, bounds] of wall.masses.entries()) {
+      maxWidth = Math.max(maxWidth, bounds.maxU - bounds.minU);
+      for (const other of wall.masses.slice(i + 1)) {
+        assert.ok(other.minU > bounds.maxU || bounds.minU > other.maxU ||
+          other.minV > bounds.maxV || bounds.minV > other.maxV, 'Individual solid blocks intersect');
+      }
+    }
+    assert.ok(maxWidth <= site.width / 3);
+    // The last two vertices of each middle triangle are perimeter vertices.
+    for (let k = wall.capTriangleCount * 3; k < wall.snow.indices.length; k += 9) {
+      for (const i of [4,5]) {
+        const vertex = wall.snow.indices[k+i] * 3;
+        const [x,y,z] = wall.snow.positions.subarray(vertex, vertex+3);
+        assert.ok(y < site.groundAt(x,z) - 0.14);
+      }
+    }
+    rows.push({ count, seed, sha, rockTriangles: wall.rock.indices.length/3,
+      snowTriangles: wall.snow.indices.length/3, maxWidth, minSnowNormal, minPassClearance, maxRoofIntrusion });
+  }
+}
+console.log(JSON.stringify({site, rows},null,2));
diff --git a/experiments/plateau/slice-wall-rounded.ts b/experiments/plateau/slice-wall-rounded.ts
new file mode 100644
index 0000000..693e225
--- /dev/null
+++ b/experiments/plateau/slice-wall-rounded.ts
@@ -0,0 +1,157 @@
+// The camera and the plateau use the existing mountain frame. Local u is along
+// the entrance shoulder and v increases out of the mountain.
+import { Color, Vector3 } from 'three';
+import { Rng } from '../../src/core/rng';
+
+export type RoundedWallSite = {
+  x: number;
+  z: number;
+  angle: number;
+  width: number;
+  height: number;
+  groundAt: (x: number, z: number) => number;
+};
+
+type Point = { u: number; v: number; y: number };
+type Mesh = { positions: number[]; indices: number[]; colors: number[] };
+type Bounds = { minU: number; maxU: number; minV: number; maxV: number; minY: number; maxY: number };
+
+export function buildRoundedWall(site: RoundedWallSite, count: 4 | 7 | 10, seed: number) {
+  const rng = new Rng(seed ^ 0x5f77c1);
+  const rock: Mesh = { positions: [], indices: [], colors: [] };
+  const snow: Mesh = { positions: [], indices: [], colors: [] };
+  const masses: Bounds[] = [];
+  const cosine = Math.cos(site.angle);
+  const sine = Math.sin(site.angle);
+  const white = new Color(1, 1, 1);
+  const palette = ['#6c7380', '#636b7a', '#626977', '#737682', '#686e7b'];
+  function world({ u, v, y }: Point) {
+    return new Vector3(site.x + cosine * u + sine * v, y, site.z + sine * u - cosine * v);
+  }
+
+  // Each triangle belongs to just one material. The common snow-line vertices
+  // close the cap without overlaying two coincident rock and snow faces.
+  function triangle(mesh: Mesh, a: Point, b: Point, c: Point, colour: Color) {
+    const first = mesh.positions.length / 3;
+    for (const p of [a, b, c]) {
+      const w = world(p);
+      mesh.positions.push(w.x, w.y, w.z);
+      mesh.colors.push(colour.r, colour.g, colour.b);
+    }
+    mesh.indices.push(first, first + 1, first + 2);
+  }
+
+  // Bilateral bevels, not a subdivided sphere. The truncated shoulders and the
+  // wide central face remain visible on the smallest preset.
+  const outline = [
+    [-0.48, -0.27], [-0.28, -0.48], [0.29, -0.48], [0.48, -0.24],
+    [0.48, 0.26], [0.22, 0.49], [-0.26, 0.47], [-0.49, 0.23],
+  ];
+  const rear = count === 4 ? 4 : count === 7 ? 4 : 6;
+  const rowCounts = count === 4 ? [rear] : [rear, count - rear];
+  for (const [row, blocks] of rowCounts.entries()) {
+    const weights = Array.from({ length: blocks }, () => rng.float(0.84, 1.13));
+    const total = weights.reduce((s, w) => s + w, 0);
+    let start = site.width * (row === 1 ? -0.44 : -0.5);
+    const span = site.width * (row === 1 ? 0.88 : 1);
+    for (const [i, weight] of weights.entries()) {
+      const cell = span * weight / total;
+      const middle = start + cell / 2;
+      start += cell;
+      const width = Math.min(site.width / 3, cell * 0.965);
+      const forward = site.width * (count === 4 ? rng.float(0.30, 0.34) : row ? 0.507 : 0.258);
+      const depth = site.width * (count === 4 ? rng.float(0.39, 0.47) : row ? 0.232 : 0.255);
+      const bottom = -3;
+      const silhouette = [0.76, 0.83, 0.43, 0.64, 0.77, 0.52];
+      const height = site.height * (row ? rng.float(0.24, 0.44) :
+        silhouette[i % silhouette.length] * rng.float(0.88, 1.08));
+      const dip = rng.float(0.43, 0.58);
+      const skew = rng.float(-0.09, 0.09);
+      const corners = outline.map(([u, v]) => ({
+        u: u * width * rng.float(0.93, 1.0),
+        v: v * depth * rng.float(0.88, 1.0),
+      }));
+      const tint = new Color(rng.pick(palette));
+      const rings: Point[][] = [];
+      const ranges: Bounds = { minU: Infinity, maxU: -Infinity, minV: Infinity, maxV: -Infinity, minY: bottom, maxY: 0 };
+      // The upper portion recedes inward. The flatter, snow-holding shoulder
+      // therefore projects beyond the summit, especially on the camera side.
+      for (const [scale, fraction, retreat] of [
+        [0.93, 0, 0.01], [1.0, 0.40, 0.01], [0.91, 0.70, 0],
+        [0.84, 0.85, -0.03], [0.48, 1.0, -0.17],
+      ]) {
+        const ring = corners.map(({ u, v }) => {
+          const p = {
+            u: middle + u * scale + width * skew * (1 - scale),
+            v: forward + v * scale + depth * retreat,
+            y: bottom + fraction * (height - bottom + skew * u - dip * v),
+          };
+          ranges.minU = Math.min(ranges.minU, p.u);
+          ranges.maxU = Math.max(ranges.maxU, p.u);
+          ranges.minV = Math.min(ranges.minV, p.v);
+          ranges.maxV = Math.max(ranges.maxV, p.v);
+          ranges.maxY = Math.max(ranges.maxY, p.y);
+          return p;
+        });
+        rings.push(ring);
+      }
+      const base = { u: middle, v: forward + depth * 0.01, y: bottom };
+      const crown = { u: middle + width * skew * 0.52, v: forward - depth * 0.17, y: height + depth * 0.035 };
+      ranges.maxY = Math.max(ranges.maxY, crown.y);
+      masses.push(ranges);
+      for (let j = 0; j < corners.length; j++) {
+        const k = (j + 1) % corners.length;
+        triangle(rock, base, rings[0][k], rings[0][j], tint);
+        for (let level = 0; level < rings.length - 1; level++) {
+          const lo = rings[level], hi = rings[level + 1];
+          for (const [a, b, c] of [[lo[j], lo[k], hi[k]], [lo[j], hi[k], hi[j]]]) {
+            const normal = world(b).sub(world(a)).cross(world(c).sub(world(a))).normalize();
+            const covered = level >= 2 && normal.y > 0.59;
+            triangle(covered ? snow : rock, a, b, c, covered ? white : tint);
+          }
+        }
+        const top = rings[rings.length - 1];
+        triangle(snow, crown, top[j], top[k], white);
+      }
+    }
+  }
+
+  const snowWallIndexCount = snow.indices.length;
+  // Wind packs a low bank at the rock feet; its edge passes under the actual
+  // terrain and the inner crest projects into the block. Separate small banks
+  // reach the gaps between blocks, leaving stretches of exposed dark rock.
+  for (const [i, mass] of masses.entries()) {
+    const width = mass.maxU - mass.minU;
+    const u = (mass.minU + mass.maxU) / 2 + width * rng.float(-0.18, 0.18);
+    const v = mass.maxV + site.width * 0.008;
+    const crest = Math.min(4.8, site.width * rng.float(0.029, 0.045));
+    const reach = site.width * rng.float(0.055, 0.091);
+    const radius = width * rng.float(0.60, 0.76);
+    // Keep banks of the rear row within their own footprint when front blocks
+    // stand in front of them; snow in these gaps is visible between the toes.
+    const minor = i < rear && rowCounts.length > 1 ? reach * 0.68 : reach;
+    const bankPoint = (u: number, v: number, lift: number) => {
+      const p = { u, v, y: 0 };
+      const w = world(p);
+      p.y = site.groundAt(w.x, w.z) + lift;
+      return p;
+    };
+    const center = bankPoint(u, v, crest);
+    const edge = Array.from({ length: 12 }, (_, j) => {
+      const a = 2 * Math.PI * j / 12;
+      return bankPoint(u + radius * Math.cos(a), v + minor * Math.sin(a), -0.17);
+    });
+    const shoulder = edge.map(p => bankPoint(0.55 * p.u + 0.45 * u, 0.55 * p.v + 0.45 * v, crest * 0.60));
+    for (let j = 0; j < edge.length; j++) {
+      const k = (j + 1) % edge.length;
+      triangle(snow, center, shoulder[j], shoulder[k], white);
+      triangle(snow, shoulder[j], edge[j], edge[k], white);
+      triangle(snow, shoulder[j], edge[k], shoulder[k], white);
+    }
+  }
+
+  function pack(data: Mesh) {
+    return { positions: Float32Array.from(data.positions), indices: Uint32Array.from(data.indices), colors: data.colors };
+  }
+  return { rock: pack(rock), snow: pack(snow), masses, snowWallIndexCount, capTriangleCount: snowWallIndexCount / 3 };
+}
