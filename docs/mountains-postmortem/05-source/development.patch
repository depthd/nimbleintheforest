@@ -0,0 +1,107 @@
+'use strict';
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+const { Module } = require('node:module');
+const { buildSync } = require('esbuild');
+const R = require('@dimforge/rapier3d-compat');
+
+function source(name) {
+  const bundle = buildSync({ entryPoints:[name], bundle:true,platform:'node',format:'cjs',write:false });
+  const record = new Module(name,module);
+  record._compile(bundle.outputFiles[0].text,name);
+  return record.exports;
+}
+const terrainModule = process.env.SLICE_TERRAIN || path.join(__dirname,'slice-terrain.ts');
+const {generateSliceTerrain} = source(terrainModule);
+const {buildSlicePassages} = source(path.join(__dirname,'slice-passages.ts'));
+const {createSliceRopeState,stepSliceRope,distance} = source(path.join(__dirname,'slice-passages-rope.ts'));
+const pt=(x,y,z)=>({x,y,z});
+const seeds=(process.env.SEEDS||'42,7,8191,23011').split(',').map(Number);
+const hash = p => {
+  const h=createHash('sha256');
+  for(const s of p.surfaces) { h.update(Buffer.from(s.positions.buffer));h.update(Buffer.from(s.indices.buffer)); }
+  return h.digest('hex');
+};
+
+function check(seed) {
+  const terrain=generateSliceTerrain(seed,{passages:true});
+  const passages=buildSlicePassages(terrain.passageAnchors,seed);
+  assert.equal(hash(passages),hash(buildSlicePassages(generateSliceTerrain(seed,{passages:true}).passageAnchors,seed)));
+  const physics=new R.World(pt(0,-9.81,0)), names=new Map();
+  const collider=(desc,name)=>{const c=physics.createCollider(desc);names.set(c.handle,name);return c;};
+  collider(R.ColliderDesc.cuboid(180,1,90).setTranslation(37,-1,0),'ground');
+  for(const [name,g] of [['host-rock',terrain.rock],['host-top',terrain.snow],...passages.surfaces.filter(s=>s.collider).map(s=>[s.name,s])])
+    collider(R.ColliderDesc.trimesh(g.positions,g.indices),name);
+  for(const t of terrain.trees) collider(R.ColliderDesc.cylinder(t.height/2,t.radius).setTranslation(t.x,t.y+t.height/2,t.z),'tree');
+  const spawn=terrain.spawn;
+  const b=physics.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(spawn.x,spawn.y+.94,spawn.z));
+  const body=physics.createCollider(R.ColliderDesc.capsule(.6,.3),b), kcc=physics.createCharacterController(.03);
+  kcc.setMaxSlopeClimbAngle(48*Math.PI/180);kcc.setMinSlopeSlideAngle(55*Math.PI/180);
+  kcc.enableAutostep(.32,.15,false);kcc.enableSnapToGround(.35);
+  let ticks=0, vY=0;
+  const feet=()=>{const v=b.translation();return pt(v.x,v.y-.9,v.z);};
+  function step(d) {
+    kcc.computeColliderMovement(body,d);
+    const v=b.translation(), m=kcc.computedMovement();
+    b.setNextKinematicTranslation(pt(v.x+m.x,v.y+m.y,v.z+m.z));physics.step();
+    ticks++;
+  }
+  function walk(target) {
+    for(let i=0;i<5000;i++) {
+      const p=feet(), dx=target.x-p.x,dz=target.z-p.z,l=Math.hypot(dx,dz);
+      if(l<.13 && Math.abs(p.y-target.y)<.31)return;
+      const s=Math.min(l,4.35/60)/Math.max(l,1e-9);
+      vY=Math.max(-18,vY-9.81/60);
+      step(pt(dx*s,vY/60,dz*s));
+      if(kcc.computedGrounded())vY=0;
+    }
+    throw new Error(JSON.stringify({seed,target,feet:feet(),ticks}));
+  }
+  const trace={};
+  physics.step();
+  // The entire route starts at the world spawn. Never move the rigid body to a waypoint.
+  for(const q of [pt(-66,0,40),pt(15,0,40),...passages.routes.den])walk(q);
+  for(let i=0;i<200;i++)step(pt(0,-.04,-.1));
+  trace.denStop=feet();assert(trace.denStop.z>19.99 && trace.denStop.z<20.4);
+  for(const q of [...passages.routes.den].reverse())walk(q);
+  const {rope}=passages;
+  for(const q of [pt(15,0,40),pt(rope.lower.x,0,40),rope.lower])walk(q);
+  function ride(sign) {
+    let state=createSliceRopeState();
+    for(let i=0;i<1600;i++){
+      const result=stepSliceRope(rope,state,feet(),{interact:i===0,climb:sign},1/60);
+      state=result.state;
+      if(!state.attached){assert(i>200);return;}
+      step(result.displacement);
+    }
+    throw new Error('rope stuck '+JSON.stringify(feet()));
+  }
+  ride(1);trace.ropeTop=feet();
+  assert(distance(feet(),rope.upper)<.18);
+  const lo=terrain.passageAnchors.throughLower, high=terrain.passageAnchors.throughUpper;
+  for(const q of [pt(12,14,rope.upper.z),pt(17,14,23),...passages.routes.through])walk(q);
+  trace.upperExit=feet();assert(Math.abs(trace.upperExit.y-high.y)<.15);
+  for(const q of [...passages.routes.through].reverse())walk(q);
+  trace.lowerExit=feet();assert(Math.abs(trace.lowerExit.y-lo.y)<.15);
+  for(const q of [pt(17,14,23),pt(12,14,rope.upper.z),rope.upper])walk(q);
+  ride(-1);trace.ropeBottom=feet();
+  assert(distance(feet(),rope.lower)<.18);
+  function ray(p,d,max) {
+    const hit=physics.castRay(new R.Ray(p,d),max,true,undefined,undefined,body);
+    return hit?{name:names.get(hit.collider.handle),distance:hit.timeOfImpact}:null;
+  }
+  const den=ray(pt(15,1,25),pt(0,1,0),13);
+  const denTop=ray(pt(15,17,25),pt(0,-1,0),5);
+  const back=ray(pt(15,1,24),pt(0,0,-1),9);
+  const ex=ray(pt(17,25,-7),pt(0,-1,0),8);
+  assert(den?.name==='passage-rock'&&den.distance>1.7);
+  assert.equal(denTop?.name,'host-top');
+  assert(back?.name==='passage-rock' && Math.abs(back.distance-4)<.03);
+  assert.equal(ex?.name,'passage-floor');
+  physics.free();
+  return {seed,meshHash:hash(passages),ticks,trace,denCeiling:den,retainedRoof:denTop,deadEnd:back,throughOpening:ex,
+    triangles:Object.fromEntries(passages.surfaces.map(s=>[s.name,s.indices.length/3]))};
+}
+R.init().then(()=>{console.log(JSON.stringify({method:'continuous Rapier KCC from spawn, scripted directional intent and rope E/W/S',reports:seeds.map(check)},null,2));})
+.catch(e=>{console.error(e);process.exitCode=1;});
diff --git a/experiments/plateau/slice-passages.ts b/experiments/plateau/slice-passages.ts
new file mode 100644
index 0000000..0746d62
--- /dev/null
+++ b/experiments/plateau/slice-passages.ts
@@ -0,0 +1,85 @@
+import { Rng } from '../../src/core/rng';
+import { append, type MeshData, type Point } from './cavity';
+import { createSliceRope, ropeDecoration } from './slice-passages-rope';
+
+export interface PassageAnchors {
+  throughLower: Point; throughUpper: Point; throughSkylightStartZ: number;
+  denMouth: Point; denBack: Point; halfWidth: number; height: number;
+  ropeLower: Point; ropeUpper: Point;
+}
+
+export type PassageSurface = MeshData & {
+  name: 'passage-rock' | 'passage-floor' | 'rope' | 'rope-anchor'; collider: boolean;
+};
+
+class Faces {
+  positions: number[] = [];
+  indices: number[] = [];
+  add(points: Point[]) { append(points, this.positions, this.indices); }
+  surface(name: PassageSurface['name']): PassageSurface {
+    return { name, collider: true, positions: new Float32Array(this.positions), indices: new Uint32Array(this.indices) };
+  }
+}
+
+const pt = (x:number,y:number,z:number): Point => ({x,y,z});
+
+export function buildSlicePassages(a: PassageAnchors, seed = 0) {
+  const rock = new Faces(), floor = new Faces(), rng = new Rng(seed);
+  const half = a.halfWidth, clearance = a.height;
+  const ring = (middle: Point, top: number, edgeHeight: number, width: number, crown: number, shift=0) =>
+    [pt(middle.x-width,middle.y,middle.z),pt(middle.x+width,middle.y,middle.z),
+     pt(middle.x+width,edgeHeight,middle.z),pt(middle.x+crown+shift,top,middle.z),
+     pt(middle.x-crown+shift,top,middle.z),pt(middle.x-width,edgeHeight,middle.z)];
+
+  function closeMouth(first: Point[]) {
+    // Fill the two corners of the host's rectangular opening up to the natural stone arch.
+    rock.add([first[3],first[2],pt(first[2].x,first[3].y,first[2].z)]);
+    rock.add([first[5],first[4],pt(first[5].x,first[4].y,first[5].z)]);
+  }
+  function lining(from:Point[],to:Point[],sky:boolean) {
+    for(let k=0;k<from.length;k++) {
+      if(sky && k!==0 && k!==1 && k!==5) continue;
+      const j=(k+1)%from.length;
+      (k===0?floor:rock).add([from[k],from[j],to[j],to[k]]);
+    }
+  }
+  const lo=a.throughLower, hi=a.throughUpper, lip=a.throughSkylightStartZ;
+  const crest=hi.z+0.5;
+  const uphillFloor = (z:number) => lo.y+(hi.y-lo.y)*Math.max(0,Math.min(1,(lo.z-z)/(lo.z-crest)));
+  const along = (t:number) => lo.z+(lip-lo.z)*t;
+  const throughZ=[lo.z,along(.26),along(.53),along(.76),lip,(lip+crest)/2,crest,hi.z];
+  let last: Point[] | undefined;
+  for(const z of throughZ) {
+    const y=uphillFloor(z), open=z<=lip, mouth=z===lo.z;
+    const width=open||mouth?half:half-rng.float(.08,.35);
+    const crown=open?width:half*rng.float(.55,.75);
+    const top=open?hi.y:Math.min(hi.y,y+clearance);
+    const side=open?hi.y:top-rng.float(.55,.92);
+    const section=ring(pt(lo.x,y,z),top,side,width,crown,open?0:rng.float(-.18,.18));
+    if(last) lining(last,section,last[0].z<=lip); else closeMouth(section);
+    last=section;
+  }
+
+  const m=a.denMouth,b=a.denBack;
+  const denRings=[0,.22,.47,.72,1].map(t=>{
+    const z=m.z+(b.z-m.z)*t;
+    // The ground plane also exists under the den. Expose one floor, gently raised inside.
+    const y=m.y+.09*Math.min(1,t/.22), width=t===0?half:half*rng.float(.80,.99);
+    const top=t===0?m.y+clearance:y+clearance*rng.float(.79,.96);
+    return ring(pt(m.x+(t===0?0:rng.float(-.18,.18)),y,z),top,top-rng.float(.55,.9),
+      width,width*rng.float(.50,.75),rng.float(-.14,.14));
+  });
+  closeMouth(denRings[0]);
+  for(let i=1;i<denRings.length;i++) lining(denRings[i-1],denRings[i],false);
+  rock.add(denRings[denRings.length-1]);
+
+  const rope=createSliceRope(a.ropeLower,a.ropeUpper);
+  const cable=ropeDecoration(rope);
+  const surfaces:PassageSurface[]=[floor.surface('passage-floor'),rock.surface('passage-rock'),
+    {...cable.line,name:'rope',collider:false}, {...cable.anchor,name:'rope-anchor',collider:false}];
+  return { surfaces, rope, entrance:{through:lo,den:m},
+    routes:{
+      through:[pt(lo.x,lo.y,lo.z+2),...throughZ.map(z=>pt(lo.x,uphillFloor(z),z)),pt(hi.x,hi.y,hi.z-1.5)],
+      den:[pt(m.x,m.y,m.z+2),pt(m.x,m.y,m.z),pt(b.x,b.y+.09,b.z+1.35)],
+    } };
+}
diff --git a/experiments/plateau/slice-terrain-browser.cjs b/experiments/plateau/slice-terrain-browser.cjs
new file mode 100644
index 0000000..41b4fd0
--- /dev/null
+++ b/experiments/plateau/slice-terrain-browser.cjs
@@ -0,0 +1,150 @@
+const { chromium } = require('playwright');
+const { mkdirSync, writeFileSync } = require('node:fs');
+const { join, resolve } = require('node:path');
+const assert = require('node:assert/strict');
+
+const output = resolve('docs/mountains-slice/tiers-entries');
+const base = process.env.SLICE_BASE_URL || 'http://127.0.0.1:5184';
+const entranceCamera = { eye: [-77, 33, -67], target: [-22, 8, -5] };
+const cases = [
+  { seed: 42, file: '42-cut.png', camera: entranceCamera },
+  { seed: 7, file: '07-wide.png', camera: entranceCamera },
+  { seed: 8191, file: '8191-peak.png', camera: { eye: [58, 38, 25], target: [34, 27, -7] } },
+];
+
+async function walk(page) {
+  const points = await page.evaluate(() => {
+    const r = window.__route;
+    r.step(40);
+    return r.terrain.routes.find((route) => route.from === 'spawn' && route.to === 'main-1').points;
+  });
+  const start = await page.evaluate(() => window.__route.state());
+  await page.keyboard.down('w');
+  let end;
+  try {
+    end = await page.evaluate((points) => {
+      const r = window.__route;
+      for (const p of points) {
+        let converged = false;
+        for (let n = 0; n < 100; n++) {
+          const q = r.state(),
+            dx = p.x - q.x,
+            dz = p.z - q.z;
+          if (Math.hypot(dx, dz) < 0.43) {
+            converged = true;
+            break;
+          }
+          r.look(Math.atan2(-dx, -dz));
+          r.step(8);
+        }
+        if (!converged)
+          throw Error(
+            'Player stuck: target ' + JSON.stringify(p) + ', position ' + JSON.stringify(r.state()),
+          );
+      }
+      return r.state();
+    }, points);
+  } finally {
+    await page.keyboard.up('w');
+  }
+  assert(Math.abs(end.y - 14) < 0.25, 'The player must finish on main-1');
+  return { start, end, checkpoints: points.length };
+}
+
+async function liveWalk(browser) {
+  const page = await browser.newPage({ viewport: { width: 320, height: 200 } });
+  try {
+    await page.goto(base + '/experiments/plateau/route.html?seed=7', { waitUntil: 'domcontentloaded' });
+    await page.waitForFunction(() => document.querySelector('#status').textContent.includes('WASD'), null, {
+      timeout: 90000,
+    });
+    assert.equal(await page.evaluate(() => Boolean(window.__route)), false);
+    const feet = () =>
+      page.evaluate(async () => {
+        const { G } = await import('/src/game/ctx.ts');
+        let result;
+        G.world.forEachRigidBody((body) => {
+          if (body.isKinematic()) {
+            const p = body.translation();
+            result = { x: p.x, y: p.y - 0.9, z: p.z };
+          }
+        });
+        return result;
+      });
+    const start = await feet(),
+      checkpoints = [start];
+    const started = Date.now();
+    let end = start;
+    await page.keyboard.down('w');
+    try {
+      while (Date.now() - started < 185000 && end.x < -15) {
+        await new Promise((resolve) => setTimeout(resolve, 1000));
+        end = await feet();
+        if (Math.abs(checkpoints.at(-1).x - end.x) >= 4) checkpoints.push(end);
+      }
+    } finally {
+      await page.keyboard.up('w');
+    }
+    assert(
+      Math.abs(start.x + 65) < 0.5 && end.x >= -15 && Math.abs(end.y - 14) < 0.3,
+      'W from spawn must reach the top, observed ' + JSON.stringify({ start, end }),
+    );
+    return {
+      seed: 7,
+      input: 'keydown W through keyup W; real animation clock; Rapier readback',
+      seconds: (Date.now() - started) / 1000,
+      start,
+      end,
+      checkpoints,
+    };
+  } finally {
+    await page.close();
+  }
+}
+
+async function run() {
+  mkdirSync(output, { recursive: true });
+  const browser = await chromium.launch({
+    headless: true,
+    executablePath: process.env.CHROMIUM || '/usr/bin/chromium',
+    args: ['--no-sandbox', '--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader'],
+  });
+  try {
+    if (process.argv.includes('--live')) {
+      const trace = await liveWalk(browser);
+      writeFileSync(join(output, 'live-walk.json'), JSON.stringify(trace, null, 2) + '\n');
+      console.log('Live W route reached', trace.end);
+      return;
+    }
+    const evidence = [];
+    for (const item of cases) {
+      const page = await browser.newPage({ viewport: { width: 1080, height: 700 } });
+      const errors = [];
+      page.on('pageerror', (e) => errors.push(e.message));
+      await page.goto(base + '/experiments/plateau/route.html?seed=' + item.seed + '&qa=1', {
+        waitUntil: 'domcontentloaded',
+      });
+      await page.waitForFunction(() => window.__route?.ready, null, { timeout: 90000 });
+      await page.addStyleTag({ content: 'header, footer { visibility: hidden }' });
+      await page.evaluate(({ eye, target }) => window.__route.survey(eye, target), item.camera);
+      await page.screenshot({ path: join(output, item.file) });
+      // Rendering each QA steering tick at screenshot resolution is expensive on software WebGL.
+      await page.setViewportSize({ width: 128, height: 96 });
+      const entrance = await page.evaluate(
+        () => window.__route.terrain.tiers.find((t) => t.id === 'main-1').entry,
+      );
+      const result = await walk(page);
+      assert.deepEqual(errors, []);
+      evidence.push({ ...item, entrance, ...result, errors });
+      console.log('Verified', item.seed, entrance, 'height', result.end.y.toFixed(2));
+      await page.close();
+    }
+    writeFileSync(join(output, 'browser.json'), JSON.stringify(evidence, null, 2) + '\n');
+  } finally {
+    await browser.close();
+  }
+}
+run().catch((e) => {
+  console.error(e);
+  process.exitCode = 1;
+});
diff --git a/experiments/plateau/slice-terrain.test.cjs b/experiments/plateau/slice-terrain.test.cjs
