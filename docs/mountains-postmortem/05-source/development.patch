+// Proof frames and a local rendering-cost comparison in the integrated scene.
+// Start Vite first. Set PLATEAU_URL if the server runs on a different origin.
+const fs = require('node:fs');
+const path = require('node:path');
+const { chromium } = require('playwright');
+
+const dir = path.resolve(__dirname,'../../docs/mountains-slice/bridges');
+const origin = process.env.PLATEAU_URL || 'http://127.0.0.1:5184';
+const views = [
+  {name:'profile', eye:[72,14.5,30], target:[75,12.9,0]},
+  {name:'bank', eye:[53.5,16.7,-1.8], target:[76,13.4,.4]},
+  {name:'on-deck', eye:[74,14.12,.4], target:[91,15.1,.4]},
+];
+
+async function main() {
+  const browser = await chromium.launch({
+    ...(process.env.CHROMIUM_PATH ? {executablePath:process.env.CHROMIUM_PATH} : {}),
+    args:['--no-sandbox','--use-gl=angle','--use-angle=swiftshader','--enable-unsafe-swiftshader'],
+  });
+  try {
+    const page = await browser.newPage({viewport:{width:960,height:540},deviceScaleFactor:1});
+    await page.routeWebSocket('**/*',socket=>socket.close());
+    await page.addInitScript(()=>{
+      const counts = window.__bridgeDraws = {draws:0,triangles:0};
+      const proto = WebGL2RenderingContext.prototype;
+      for (const name of ['drawArrays','drawArraysInstanced','drawElements','drawElementsInstanced']) {
+        const draw = proto[name];
+        proto[name] = function(...args) {
+          counts.draws++;
+          if (args[0]===this.TRIANGLES) {
+            const count = name.includes('Elements') ? args[1] : args[2];
+            const instances = name.endsWith('Instanced') ? args[args.length-1] : 1;
+            counts.triangles+=count/3*instances;
+          }
+          return draw.apply(this,args);
+        };
+      }
+    });
+    const captures=[];
+    for (const seed of [42,7,8191,23011]) {
+      await page.goto(origin+'/experiments/plateau/route.html?seed='+seed+'&wall=original&qa=1');
+      await page.waitForFunction(()=>window.__route?.ready,null,{timeout:60000});
+      await page.addStyleTag({content:'header,footer{display:none!important}'});
+      const raw=await page.evaluate(async ({seed,views})=>{
+        const {G} = await import('/src/game/ctx.ts');
+        const bridge = G.scene.getObjectByName('suspension-bridge');
+        const gl = document.querySelector('canvas').getContext('webgl2');
+        const ext = gl.getExtension('WEBGL_debug_renderer_info');
+        const {survey} = window.__route;
+        const pixel = new Uint8Array(4);
+        const sync = ()=>gl.readPixels(0,0,1,1,gl.RGBA,gl.UNSIGNED_BYTE,pixel);
+        const measure = (visible)=>{
+          bridge.visible=visible;
+          const {eye,target}=views[0];
+          for (let i=0;i<4;i++) { survey(eye,target); sync(); }
+          const samples=[];
+          let calls,triangles;
+          for (let i=0;i<12;i++) {
+            window.__bridgeDraws.draws=window.__bridgeDraws.triangles=0;
+            const start=performance.now();
+            survey(eye,target);
+            sync();
+            samples.push(performance.now()-start);
+            ({draws:calls,triangles}=window.__bridgeDraws);
+          }
+          samples.sort((a,b)=>a-b);
+          return {calls,triangles,medianMs:(samples[5]+samples[6])/2,rangeMs:[samples[0],samples.at(-1)]};
+        };
+        const off=measure(false),on=measure(true);
+        return {seed,renderer:ext?gl.getParameter(ext.UNMASKED_RENDERER_WEBGL):gl.getParameter(gl.RENDERER),
+          off,on,endpoints:[window.__route.bridge[0],window.__route.bridge.at(-1)]};
+      },{seed,views});
+      for (const view of (seed===42?views:views.slice(0,1))) {
+        const url = await page.evaluate(view=>{
+          window.__route.survey(view.eye,view.target);
+          return document.querySelector('canvas').toDataURL('image/jpeg',.92);
+        },view);
+        fs.writeFileSync(path.join(dir,'bridge-'+seed+'-'+view.name+'.jpg'),Buffer.from(url.split(',')[1],'base64'));
+      }
+      console.log(seed,raw.off,raw.on);
+      captures.push(raw);
+    }
+    fs.writeFileSync(path.join(dir,'browser.json'),JSON.stringify({
+      viewport:[960,540],browser:browser.version(),views,measure:'12 renders per state, synchronized WebGL readPixels, median; camera profile, bridge group hidden/visible',
+      captures},null,2)+'\n');
+  } finally { await browser.close(); }
+}
+main().catch(error=>{ console.error(error);process.exitCode=1; });
diff --git a/experiments/plateau/slice-bridges.test.cjs b/experiments/plateau/slice-bridges.test.cjs
new file mode 100644
index 0000000..3ab2db1
--- /dev/null
+++ b/experiments/plateau/slice-bridges.test.cjs
@@ -0,0 +1,131 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const Module = require('node:module');
+const { buildSync } = require('esbuild');
+const R = require('@dimforge/rapier3d-compat');
+
+function compile(file) {
+  const unit = new Module(__filename);
+  unit.paths = module.paths;
+  const build = buildSync({ entryPoints: [file], bundle: true, platform: 'node', format: 'cjs', write: false });
+  unit._compile(build.outputFiles[0].text, file);
+  return unit.exports;
+}
+
+const { planSliceBridge } = compile(path.join(__dirname, 'slice-bridges.ts'));
+const { generateSliceTerrain } = compile(path.resolve(process.argv[2] || path.join(__dirname, 'slice-terrain.ts')));
+const fixedSeeds = [42, 7, 8191];
+const heldOut = 23011;
+
+// This spatial graph is built from sampled supports, independently of the
+// plan's declared reachability. Keys retain height: canyon and deck coexist.
+function supportPath(terrain, bridge) {
+  const queue = [terrain.spawn];
+  const seen = new Set();
+  for (let i = 0; i < queue.length; i++) {
+    const cur = queue[i];
+    if (cur.x > 94 && cur.y >= 13.9) return true;
+    for (const [dx,dz] of [[1,0],[-1,0],[0,1],[0,-1]]) {
+      const x = cur.x+dx, z = cur.z+dz;
+      if (x < -68 || x > 166 || z < -40 || z > 40) continue;
+      const heights = [terrain.sampleHeight(x,z)];
+      if (bridge) {
+        const dx = (bridge.to.x-bridge.from.x)/bridge.span, dz = (bridge.to.z-bridge.from.z)/bridge.span;
+        const ox = x-bridge.from.x, oz = z-bridge.from.z;
+        const along = ox*dx+oz*dz, across = Math.abs(oz*dx-ox*dz);
+        if (along>=0 && along<=bridge.span && across <=bridge.width/2-.30) heights.push(bridge.point(along).y);
+      }
+      for (const y of heights) {
+        if (Math.abs(cur.y-y) > Math.tan(48*Math.PI/180)) continue;
+        if (terrain.trees.some(t => t.y<y+1.8 && t.y+t.height>y && Math.hypot(t.x-x,t.z-z)<t.radius+.30)) continue;
+        const key = [x, z, Math.round(y*100)].join('/');
+        if (seen.has(key)) continue;
+        seen.add(key);
+        queue.push({x,z,y});
+      }
+    }
+  }
+  return false;
+}
+
+function walk(terrain, bridge, enabled, reverse) {
+  const physics = new R.World({x:0,y:-9.81,z:0});
+  for (const raw of [terrain.rock,terrain.snow]) {
+    physics.createCollider(R.ColliderDesc.trimesh(raw.positions,raw.indices));
+  }
+  physics.createCollider(R.ColliderDesc.cuboid(200,.2,100).setTranslation(48,-.2,0));
+  for (const tree of terrain.trees) {
+    physics.createCollider(R.ColliderDesc.cylinder(tree.height/2,tree.radius).setTranslation(tree.x,tree.y+tree.height/2,tree.z));
+  }
+  const deck = enabled ? physics.createCollider(R.ColliderDesc.trimesh(bridge.collider.positions,bridge.collider.indices)) : null;
+  const sign = reverse ? -1 : 1;
+  const start = (reverse ? bridge.to : bridge.from).x-sign*2;
+  const finish = (reverse ? bridge.from : bridge.to).x+sign*2;
+  const body = physics.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(start,14+.95,bridge.from.z));
+  const actor = physics.createCollider(R.ColliderDesc.capsule(.6,.30),body);
+  const ctrl = physics.createCharacterController(.03);
+  ctrl.setMaxSlopeClimbAngle(48*Math.PI/180);
+  ctrl.setMinSlopeSlideAngle(55*Math.PI/180);
+  ctrl.enableAutostep(.32,.15,false);
+  ctrl.enableSnapToGround(.35);
+  physics.step();
+  let vertical = 0, crossed = false, midDeckSupport = false, minEyeClearance = Infinity;
+  for (let t=0; t<1700; t++) {
+    const prev = body.translation();
+    vertical = Math.max(-30,vertical-9.81/60);
+    ctrl.computeColliderMovement(actor,{x:sign*1.72/60,y:vertical/60,z:0});
+    const move = ctrl.computedMovement();
+    body.setNextKinematicTranslation({x:prev.x+move.x,y:prev.y+move.y,z:prev.z+move.z});
+    physics.step();
+    if (ctrl.computedGrounded()) vertical=-.5;
+    const cur=body.translation();
+    if (Math.abs(cur.x-(bridge.from.x+bridge.to.x)/2)<.6 && deck) {
+      const ray = new R.Ray({x:cur.x,y:cur.y+.80,z:cur.z},{x:0,y:-1,z:0});
+      const hit = physics.castRay(ray,2.5,true,undefined,undefined,actor);
+      if (hit && hit.collider.handle===deck.handle) {
+        midDeckSupport=true;
+        minEyeClearance=Math.min(minEyeClearance,hit.timeOfImpact);
+      }
+    }
+    if (sign*(cur.x-finish)>=0 && Math.abs(cur.y-.9-14)<.25) { crossed=true; break; }
+  }
+  const end = {...body.translation()};
+  physics.free();
+  return {crossed,midDeckSupport,minEyeClearance:Number.isFinite(minEyeClearance)?minEyeClearance:null,end};
+}
+
+async function main() {
+  await R.init();
+  for (const seed of [...fixedSeeds,heldOut]) {
+    const terrain = generateSliceTerrain(seed,{passages:true});
+    const bridge = planSliceBridge(terrain);
+    assert.ok(bridge,'Actual anchors form a valid crossing');
+    assert.notEqual(bridge.from.mountainId,bridge.to.mountainId);
+    assert.equal(bridge.span,32);
+    assert.ok(bridge.sag>0 && bridge.dropAtCenter>10);
+    const repeat = planSliceBridge(generateSliceTerrain(seed,{passages:true}));
+    assert.deepEqual(bridge.collider,repeat.collider);
+    assert.equal(supportPath(terrain,bridge),true);
+    assert.equal(supportPath(terrain,null),false);
+    const forward=walk(terrain,bridge,true,false),reverse=walk(terrain,bridge,true,true);
+    const missing=walk(terrain,bridge,false,false);
+    for (const trip of [forward,reverse]) {
+      assert.equal(trip.crossed,true);
+      assert.equal(trip.midDeckSupport,true);
+      assert.ok(trip.minEyeClearance>1.6);
+    }
+    assert.equal(missing.crossed,false);
+    assert.equal(planSliceBridge({...terrain,bridgeAnchors:terrain.bridgeAnchors.map(a=>({...a,accessible:false}))}),null);
+    assert.equal(planSliceBridge({...terrain,bridgeAnchors:terrain.bridgeAnchors.map(a=>({...a,mountainId:'one'}))}),null);
+    const mid=bridge.point(bridge.span/2);
+    assert.equal(planSliceBridge({...terrain,trees:[{...mid,y:0,height:17,radius:.35}]}),null);
+    const obstruction = {x:mid.x, y:mid.y, z:mid.z+1.45, height:.8, radius:.12};
+    const shifted = planSliceBridge({...terrain,trees:[obstruction]});
+    assert.ok(shifted && shifted.from.z !== bridge.from.z,'A clear alternative is chosen across the landing');
+    assert.equal(planSliceBridge({...terrain,sampleHeight:(x,z)=>Math.abs(x-mid.x)<.8?20:terrain.sampleHeight(x,z)}),null);
+    console.log(JSON.stringify({seed,span:bridge.span,sag:bridge.sag,clearance:bridge.dropAtCenter,deckTriangles:bridge.collider.indices.length/3,graphWith:true,graphWithout:false,forward,reverse,withoutBridge:missing}));
+  }
+}
+main().catch(error=>{console.error(error);process.exitCode=1;});
diff --git a/experiments/plateau/slice-bridges.ts b/experiments/plateau/slice-bridges.ts
new file mode 100644
index 0000000..2fd55e6
--- /dev/null
+++ b/experiments/plateau/slice-bridges.ts
@@ -0,0 +1,172 @@
+import * as THREE from 'three';
+import { Tex } from '../../src/core/textures';
+import { Rng, hashString } from '../../src/core/rng';
+import type { Point, MeshData } from './cavity';
+
+type Anchor = Point & { mountainId: string; tierId: string; accessible: boolean };
+type Tree = Point & { radius: number; height: number };
+interface Terrain {
+  seed: number;
+  bridgeAnchors: readonly Anchor[];
+  trees: readonly Tree[];
+  sampleHeight(x: number, z: number): number;
+}
+
+const WIDTH = 2.4;
+const LANDING = 1;
+const THICKNESS = 0.12;
+// Measured in the T slice: 30 m of air and a metre of bearing at either end.
+const SLICE_SPAN = 32;
+
+function planPair(terrain: Terrain, from: Anchor, to: Anchor) {
+  if (!from.accessible || !to.accessible || from.mountainId === to.mountainId) return null;
+  const dx = to.x - from.x, dz = to.z - from.z;
+  const span = Math.hypot(dx, dz);
+  if (span <= 2 * LANDING || span > SLICE_SPAN + 1e-5) return null;
+  const forwardX = dx / span, forwardZ = dz / span;
+  const openSpan = span - LANDING * 2, sag = openSpan / 17;
+  function point(along: number, side = 0, lift = 0): Point {
+    const t = Math.max(0, Math.min(1, (along - LANDING) / openSpan));
+    return {
+      x: from.x + forwardX * along - forwardZ * side,
+      z: from.z + forwardZ * along + forwardX * side,
+      y: from.y + (to.y - from.y) * t + THICKNESS - 4 * sag * t * (1 - t) + lift,
+    };
+  }
+
+  const count = Math.ceil(span / .30);
+  const sections = [0, ...Array.from({length:count + 1}, (_, i) => LANDING + openSpan * i / count), span];
+  const route = sections.map(d => point(d));
+  for (let i = 0; i < sections.length; i++) {
+    const along = sections[i];
+    const onBank = along <= LANDING || along >= span - LANDING;
+    for (const side of [-WIDTH/2, -WIDTH/4, 0, WIDTH/4, WIDTH/2]) {
+      const p = point(along, side);
+      const ground = terrain.sampleHeight(p.x, p.z), gap = p.y - THICKNESS - ground;
+      if (!Number.isFinite(ground) || gap < -.001 || (onBank && gap > .15)) return null;
+    }
+    if (i > 0 && Math.abs(route[i].y - route[i-1].y) > Math.tan(Math.PI * 48/180) * (along - sections[i-1])) return null;
+  }
+  const center = point(span/2);
+  const dropAtCenter = center.y - THICKNESS - terrain.sampleHeight(center.x, center.z);
+  if (!(dropAtCenter > 1.8)) return null;
+  for (const tree of terrain.trees) {
+    const along = Math.max(0, Math.min(span, (tree.x-from.x)*forwardX + (tree.z-from.z)*forwardZ));
+    const p = point(along);
+    // The renderer's outermost crown has radius 0.24 × height. Enclose the
+    // whole tree and the anchor posts, not merely the centre line of the deck.
+    const reach = Math.max(tree.radius, .24 * tree.height) + WIDTH/2 + .16;
+    if (Math.hypot(tree.x-p.x, tree.z-p.z) <= reach && tree.y+tree.height >= p.y-THICKNESS && tree.y <= p.y+2) return null;
+  }
+
+  const positions: number[] = [], indices: number[] = [];
+  for (const d of sections) {
+    for (const side of [-WIDTH/2, WIDTH/2]) {
+      const p = point(d, side);
+      positions.push(p.x,p.y,p.z);
+    }
+    const last = positions.length/3-2;
+    if (last) indices.push(last-2,last-1,last+1, last-2,last+1,last);
+  }
+  const collider: MeshData = {positions:Float32Array.from(positions), indices:Uint32Array.from(indices)};
+  return {from,to,span,width:WIDTH,sag,dropAtCenter,point,sections,route,collider};
+}
+
+// Pick the shortest viable crossing after the terrain, trees and accessible
+// landing metadata are known. Equal distances retain the generator's order.
+export function planSliceBridge(terrain: Terrain) {
+  let shortest: ReturnType<typeof planPair> = null;
+  for (let a=0; a<terrain.bridgeAnchors.length; a++) {
+    for (let b=a+1; b<terrain.bridgeAnchors.length; b++) {
+      const left = terrain.bridgeAnchors[a], right = terrain.bridgeAnchors[b];
+      const length = Math.hypot(right.x-left.x, right.z-left.z);
+      if (!length || length > SLICE_SPAN + 1e-5) continue;
+      const nx = -(right.z-left.z)/length, nz = (right.x-left.x)/length;
+      const rng = new Rng(terrain.seed ^ hashString(left.tierId+'|'+right.tierId));
+      // Try a reproducible offset in the reserved 8 m corridor. If a tree or a
+      // rock blocks it, retry the centre and both sides before dropping the link.
+      for (const offset of [rng.float(-1.2,1.2),0,-1.2,1.2]) {
+        const shift = (anchor: Anchor) => ({...anchor,x:anchor.x+nx*offset,z:anchor.z+nz*offset});
+        const candidate = planPair(terrain,shift(left),shift(right));
+        if (!candidate) continue;
+        if (!shortest || candidate.span < shortest.span) shortest = candidate;
+        break;
+      }
+    }
+  }
+  return shortest;
+}
+
+export function buildSliceBridges(terrain: Terrain) {
+  const plan = planSliceBridge(terrain);
+  if (!plan) return null;
+  const {point,span,sections} = plan;
+  const group = new THREE.Group();
+  group.name = 'suspension-bridge';
+  const wood = new THREE.MeshStandardMaterial({map: Tex.planks(), color:0x94806c, roughness:1,flatShading:true});
+  const rope = new THREE.MeshStandardMaterial({color:0x514736,roughness:1,flatShading:true});
+  const pos: THREE.Vector3 = new THREE.Vector3();
+  const scale: THREE.Vector3 = new THREE.Vector3();
+  const local: THREE.Object3D = new THREE.Object3D();
+  const across = new THREE.Vector3(-(plan.to.z-plan.from.z)/span,0,(plan.to.x-plan.from.x)/span);
+  const top = new THREE.Vector3();
+  const forward = new THREE.Vector3();
+  const orientation = new THREE.Matrix4();
+
+  // Axis x is along each transverse plank, z is uphill along the path.
+  const planks = new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),wood,sections.length-1);
+  planks.name = 'transverse-planks';
+  for (let i=1; i<sections.length; i++) {
+    const a=point(sections[i-1]), b=point(sections[i]);
+    forward.set(b.x-a.x,b.y-a.y,b.z-a.z);
+    const length=forward.length();
+    forward.normalize();
+    top.crossVectors(forward,across).negate().normalize();
+    orientation.makeBasis(across,top,forward.clone().negate());
+    local.quaternion.setFromRotationMatrix(orientation);
+    local.position.set((a.x+b.x)/2,(a.y+b.y)/2,(a.z+b.z)/2).addScaledVector(top,-THICKNESS/2);
+    local.scale.set(WIDTH,THICKNESS,length-.009);
+    local.updateMatrix();
+    planks.setMatrixAt(i-1,local.matrix);
+  }
+  planks.receiveShadow = true;
+  planks.castShadow = true;
+  group.add(planks);
+
+  const up = new THREE.Vector3(0,1,0);
+  const members: THREE.Matrix4[] = [], cables: THREE.Matrix4[] = [];
+  function bar(a: Point, b: Point, radius: number, target: THREE.Matrix4[]) {
+    const axis = new THREE.Vector3(b.x-a.x,b.y-a.y,b.z-a.z);
+    const len = axis.length();
+    const rotation = new THREE.Quaternion().setFromUnitVectors(up,axis.normalize());
+    pos.set((a.x+b.x)/2,(a.y+b.y)/2,(a.z+b.z)/2);
+    scale.set(radius,len,radius);
+    target.push(new THREE.Matrix4().compose(pos,rotation,scale));
+  }
+  const cableSections = Math.ceil((span-2*LANDING)/1.2);
+  for (const side of [-WIDTH/2,WIDTH/2]) {
+    for (const d of [.4,span-.4]) bar(point(d,side,-.30),point(d,side,1.8),.13,members);
+    let previousTop=point(.4,side,1.65), previousBottom=point(.4,side,-.10);
+    for (let i=0;i<=cableSections;i++) {
+      const t=i/cableSections, d=LANDING+t*(span-2*LANDING);
+      const high=point(d,side,1.65-2*t*(1-t)), low=point(d,side,-.10);
+      bar(previousTop,high,.044,cables);
+      bar(previousBottom,low,.052,cables);
+      bar(low,high,.027,cables);
+      previousTop=high;previousBottom=low;
+    }
+    bar(previousTop,point(span-.4,side,1.65),.044,cables);
+    bar(previousBottom,point(span-.4,side,-.10),.052,cables);
+  }
+  function addMembers(matrices: THREE.Matrix4[], material: THREE.Material, name: string) {
+    const mesh = new THREE.InstancedMesh(new THREE.CylinderGeometry(1,1,1,5,1),material,matrices.length);
+    mesh.name=name;
+    matrices.forEach((matrix,i)=>mesh.setMatrixAt(i,matrix));
+    mesh.receiveShadow=true;
+    mesh.castShadow=true;
+    group.add(mesh);
+  }
+  addMembers(members,wood,'bank-anchors');
+  addMembers(cables,rope,'suspension-cables-and-hangers');
+  return {...plan,group};
+}
