+        z,
+        angle: 0,
+        width,
+        depth,
+        height: height * rng.float(0.65, 0.95),
+        base: s.bottom - 0.2,
+        lean: 0.1,
+        rake: 0.3,
+        crown: 0.08,
+        wear: 0.5,
